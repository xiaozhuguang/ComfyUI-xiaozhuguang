  "XiaozhuguangColorAdjust": {
    "display_name": "XZG Color Adjust",
    "description": "Fast color adjust: brightness / contrast / saturation (step 0.01), batch image in/out. Pure tensor elementwise ops over the whole batch at once, no loops no PIL; passthrough with zero copy when all params are default. Order: brightness → contrast → saturation.",
    "inputs": {
      "图像": { "name": "image" },
      "亮度": { "name": "brightness", "tooltip": "Brightness offset: 0 = unchanged, positive brightens, negative darkens (-1~1, step 0.01)" },
      "对比度": { "name": "contrast", "tooltip": "Contrast factor: 1 = unchanged, >1 stronger, <1 weaker, 0 = flat gray (0~3, step 0.01)" },
      "饱和度": { "name": "saturation", "tooltip": "Saturation factor: 1 = unchanged, >1 vivid, <1 desaturated, 0 = grayscale (0~3, step 0.01)" }
    },
    "outputs": {
      "0": { "name": "image" }
    }
  },
  "XiaozhuguangImageMaskPreview": {
    "display_name": "XZG Image-Mask Preview",
    "description": "Always passthrough: returns the composite directly without saving previews. Image-only passes through; mask-only outputs grayscale; with both, the masked region is composited (solid color / mosaic / colored mosaic) and mask_opacity controls blend strength (gradient masks supported).",
    "inputs": {
      "image": { "name": "image" },
      "mask": { "name": "mask" },
      "mask_opacity": { "name": "mask opacity", "tooltip": "Blend strength of the masked region 0~1; gradient masks supported" },
      "mask_color": { "name": "mask color", "tooltip": "RGB (255,255,255) or RGBA (255,255,255,128) or Hex (#RRGGBB / #RRGGBBAA); per-channel alpha applies in solid mode" },
      "invert_mask": { "name": "invert mask" },
      "fill_mode": {
        "name": "fill mode",
        "tooltip": "Solid = overlay mask_color; Mosaic = pixelate the image inside the mask; Color mosaic = fixed colored blocks (color determined by block position, stable across frames)",
        "options": {
          "纯色": { "text": "Solid" },
          "马赛克": { "text": "Mosaic" },
          "彩色马赛克": { "text": "Color Mosaic" }
        }
      },
      "mosaic_block": { "name": "mosaic block size", "tooltip": "Block size in pixels for mosaic / color mosaic; only applies to those modes" }
    },
    "outputs": {
      "0": { "name": "composite" }
    }
  }
